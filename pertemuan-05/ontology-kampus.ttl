@prefix : <https://naufal-awnharahap.github.io/web-semantik-Kelompok04/ontology/kampus#> .
@prefix kampus: <https://naufal-awnharahap.github.io/web-semantik-Kelompok04/ontology/kampus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

### Object Properties

:belongsToDepartment a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Department .

:takesCourse a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain :Student ;
    rdfs:range :Course .

:teachesCourse a owl:ObjectProperty ;
    rdfs:domain :Lecturer ;
    rdfs:range :Course .

### Data Properties

:hasNIM a owl:DatatypeProperty ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasName a owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasNIM ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

### Classes

:Course a owl:Class .

:Department a owl:Class .

:Lecturer a owl:Class ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Student .

:Person a owl:Class .

:Student a owl:Class ;
    rdfs:subClassOf :Person .

### Individuals

:CintaPardameSialoho a owl:NamedIndividual ;
    rdf:type :Lecturer ;
    :teachesCourse :WebSemantik ;
    :hasName "Cinta Pardame Sialoho" .

:FelixDesseloTambunan a owl:NamedIndividual ;
    rdf:type :Student ;
    :takesCourse :WebSemantik ;
    :hasNIM 251402033 ;
    :hasName "Felix Desselo Tambunan" .

:NaufalAwan a owl:NamedIndividual ;
    rdf:type :Student ;
    :takesCourse :WebSemantik ;
    :hasNIM 251402145 ;
    :hasName "Naufal Awan" .

:TeknikInformatika a owl:NamedIndividual ;
    rdf:type :Department .

:WebSemantik a owl:NamedIndividual ;
    rdf:type :Course .
